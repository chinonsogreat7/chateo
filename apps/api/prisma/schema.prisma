generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OtpPurpose {
  SIGN_IN
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum SessionRevocationReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
  ADMIN
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageKind {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum MediaPurpose {
  PROFILE_AVATAR
  GROUP_AVATAR
  MESSAGE_ATTACHMENT
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum PushStatus {
  PENDING
  RECEIPT
  SENT
  SKIPPED
  FAILED
}

model User {
  id                           String               @id @default(uuid()) @db.Uuid
  phoneNumber                  String               @unique @map("phone_number") @db.VarChar(16)
  phoneVerifiedAt              DateTime             @map("phone_verified_at") @db.Timestamptz(3)
  displayName                  String?              @map("display_name") @db.VarChar(80)
  avatarUrl                    String?              @map("avatar_url") @db.Text
  avatarMediaId                String?              @unique @map("avatar_media_id") @db.Uuid
  profileCompletedAt           DateTime?            @map("profile_completed_at") @db.Timestamptz(3)
  createdAt                    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  avatarMedia                  MediaAsset?          @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  mediaAssets                  MediaAsset[]         @relation("MediaOwner")
  sessions                     AuthSession[]
  conversationMemberships      ConversationMember[]
  directConversationsAsUserOne Conversation[]       @relation("DirectUserOne")
  directConversationsAsUserTwo Conversation[]       @relation("DirectUserTwo")
  groupsCreated                Conversation[]       @relation("GroupCreator")
  messagesSent                 Message[]
  messageReactions             MessageReaction[]
  blocksInitiated              UserBlock[]          @relation("Blocker")
  blocksReceived               UserBlock[]          @relation("Blocked")
  pushDevices                  PushDevice[]

  @@map("users")
}

model MediaAsset {
  id                 String              @id @default(uuid()) @db.Uuid
  ownerId            String              @map("owner_id") @db.Uuid
  clientUploadId     String              @map("client_upload_id") @db.Uuid
  uploadFingerprint  String              @map("upload_fingerprint") @db.VarChar(64)
  purpose            MediaPurpose
  status             MediaStatus         @default(PENDING)
  cloudinaryPublicId String              @unique @map("cloudinary_public_id") @db.VarChar(255)
  cloudinaryAssetId  String?             @unique @map("cloudinary_asset_id") @db.VarChar(255)
  resourceType       String              @default("image") @map("resource_type") @db.VarChar(16)
  deliveryType       String              @default("upload") @map("delivery_type") @db.VarChar(32)
  format             String?             @db.VarChar(32)
  mimeType           String              @map("mime_type") @db.VarChar(127)
  byteSize           Int                 @map("byte_size")
  contentSha256      String?             @map("content_sha256") @db.VarChar(64)
  width              Int?
  height             Int?
  durationMs         Int?                @map("duration_ms")
  originalFilename   String?             @map("original_filename") @db.VarChar(255)
  secureUrl          String?             @map("secure_url") @db.Text
  etag               String?             @db.VarChar(64)
  expiresAt          DateTime            @map("expires_at") @db.Timestamptz(3)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(3)
  messageClaimedAt   DateTime?           @map("message_claimed_at") @db.Timestamptz(3)
  unusedSince        DateTime?           @map("unused_since") @db.Timestamptz(3)
  failedAt           DateTime?           @map("failed_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner              User                @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profileAvatarFor   User?               @relation("UserAvatar")
  groupAvatars       Conversation[]      @relation("GroupAvatar")
  messageAttachments MessageAttachment[]

  @@unique([ownerId, clientUploadId])
  @@index([ownerId, createdAt])
  @@index([status, expiresAt])
  @@index([status, unusedSince, id])
  @@map("media_assets")
}

model Conversation {
  id              String               @id @default(uuid()) @db.Uuid
  type            ConversationType     @default(DIRECT)
  directUserOneId String?              @map("direct_user_one_id") @db.Uuid
  directUserTwoId String?              @map("direct_user_two_id") @db.Uuid
  name            String?              @db.VarChar(100)
  avatarUrl       String?              @map("avatar_url") @db.Text
  avatarMediaId   String?              @map("avatar_media_id") @db.Uuid
  createdById     String?              @map("created_by_id") @db.Uuid
  lastActivityAt  DateTime             @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  directUserOne   User?                @relation("DirectUserOne", fields: [directUserOneId], references: [id], onDelete: Cascade)
  directUserTwo   User?                @relation("DirectUserTwo", fields: [directUserTwoId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  avatarMedia     MediaAsset?          @relation("GroupAvatar", fields: [avatarMediaId], references: [id], onDelete: Restrict)
  members         ConversationMember[]
  messages        Message[]

  @@unique([directUserOneId, directUserTwoId])
  @@index([directUserOneId])
  @@index([directUserTwoId])
  @@index([createdById])
  @@index([avatarMediaId])
  @@index([lastActivityAt, id])
  @@map("conversations")
}

model ConversationMember {
  conversationId          String                 @map("conversation_id") @db.Uuid
  userId                  String                 @map("user_id") @db.Uuid
  joinedAt                DateTime               @default(now()) @map("joined_at") @db.Timestamptz(3)
  role                    ConversationMemberRole @default(MEMBER)
  archivedAt              DateTime?              @map("archived_at") @db.Timestamptz(3)
  mutedAt                 DateTime?              @map("muted_at") @db.Timestamptz(3)
  mutedUntil              DateTime?              @map("muted_until") @db.Timestamptz(3)
  pinnedAt                DateTime?              @map("pinned_at") @db.Timestamptz(3)
  favoritedAt             DateTime?              @map("favorited_at") @db.Timestamptz(3)
  clearedAt               DateTime?              @map("cleared_at") @db.Timestamptz(3)
  clearedThroughMessageId String?                @map("cleared_through_message_id") @db.Uuid
  unreadCount             Int                    @default(0) @map("unread_count")
  lastReadAt              DateTime?              @map("last_read_at") @db.Timestamptz(3)
  receiptVersion          Int                    @default(0) @map("receipt_version")
  conversation            Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageReceipts         MessageReceipt[]

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@index([userId, archivedAt])
  @@index([userId, pinnedAt])
  @@index([userId, favoritedAt])
  @@map("conversation_members")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId, blockerId])
  @@map("user_blocks")
}

model Message {
  id                String              @id @default(uuid()) @db.Uuid
  conversationId    String              @map("conversation_id") @db.Uuid
  senderId          String              @map("sender_id") @db.Uuid
  clientMessageId   String              @map("client_message_id") @db.Uuid
  kind              MessageKind         @default(TEXT)
  text              String?             @db.VarChar(4000)
  sendFingerprint   String?             @map("send_fingerprint") @db.VarChar(64)
  replyToMessageId  String?             @map("reply_to_message_id") @db.Uuid
  editedAt          DateTime?           @map("edited_at") @db.Timestamptz(3)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(3)
  version           Int                 @default(0)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receipts          MessageReceipt[]
  attachments       MessageAttachment[]
  replyTo           Message?            @relation("MessageReplies", fields: [replyToMessageId, conversationId], references: [id, conversationId], onDelete: NoAction, onUpdate: NoAction)
  replies           Message[]           @relation("MessageReplies")
  reactions         MessageReaction[]
  pushNotifications PushNotification[]

  @@unique([senderId, clientMessageId])
  @@unique([id, conversationId])
  @@index([conversationId, createdAt, id])
  @@index([replyToMessageId, conversationId])
  @@map("messages")
}

model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(32)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_reactions")
}

model PushDevice {
  id            String             @id @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  familyId      String             @map("family_id") @db.Uuid
  platform      DevicePlatform
  token         String?            @db.VarChar(255)
  tokenHash     String?            @unique @map("token_hash") @db.Char(64)
  version       Int                @default(0)
  registeredAt  DateTime           @map("registered_at") @db.Timestamptz(3)
  disabledAt    DateTime?          @map("disabled_at") @db.Timestamptz(3)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications PushNotification[]

  @@index([userId, disabledAt])
  @@map("push_devices")
}

model PushNotification {
  id            String     @id @default(uuid()) @db.Uuid
  messageId     String     @map("message_id") @db.Uuid
  deviceId      String     @map("device_id") @db.Uuid
  deviceVersion Int        @map("device_version")
  status        PushStatus @default(PENDING)
  attempts      Int        @default(0)
  nextAttemptAt DateTime   @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken    String?    @map("lease_token") @db.Uuid
  leaseUntil    DateTime?  @map("lease_until") @db.Timestamptz(3)
  ticketId      String?    @map("ticket_id") @db.VarChar(255)
  ticketAt      DateTime?  @map("ticket_at") @db.Timestamptz(3)
  errorCode     String?    @map("error_code") @db.VarChar(64)
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  message       Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  device        PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([messageId, deviceId])
  @@index([status, nextAttemptAt, id])
  @@index([deviceId])
  @@map("push_notifications")
}

model MessageAttachment {
  messageId    String     @map("message_id") @db.Uuid
  mediaAssetId String     @unique @map("media_asset_id") @db.Uuid
  position     Int
  message      Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([messageId, position])
  @@map("message_attachments")
}

model MessageReceipt {
  messageId      String             @map("message_id") @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  deliveredAt    DateTime           @map("delivered_at") @db.Timestamptz(3)
  readAt         DateTime?          @map("read_at") @db.Timestamptz(3)
  message        Message            @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  member         ConversationMember @relation(fields: [conversationId, userId], references: [conversationId, userId], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([conversationId, userId, readAt])
  @@map("message_receipts")
}

model OtpChallenge {
  id                String     @id @default(uuid()) @db.Uuid
  phoneNumber       String     @map("phone_number") @db.VarChar(16)
  purpose           OtpPurpose @default(SIGN_IN)
  codeDigest        String     @map("code_digest") @db.Char(64)
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  resendAvailableAt DateTime   @map("resend_available_at") @db.Timestamptz(3)
  attemptsRemaining Int        @default(5) @map("attempts_remaining")
  lastSentAt        DateTime   @map("last_sent_at") @db.Timestamptz(3)
  consumedAt        DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([phoneNumber, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model OtpAttemptBudget {
  phoneNumber    String    @id @map("phone_number") @db.VarChar(16)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lockedUntil])
  @@map("otp_attempt_budgets")
}

model AuthSession {
  id            String                   @id @default(uuid()) @db.Uuid
  familyId      String                   @map("family_id") @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  tokenDigest   String                   @unique @map("token_digest") @db.Char(64)
  deviceName    String?                  @map("device_name") @db.VarChar(120)
  platform      DevicePlatform           @default(UNKNOWN)
  ipAddress     String?                  @map("ip_address") @db.VarChar(64)
  userAgent     String?                  @map("user_agent") @db.VarChar(512)
  expiresAt     DateTime                 @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime                 @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason SessionRevocationReason? @map("revoked_reason")
  replacedById  String?                  @unique @map("replaced_by_id") @db.Uuid
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy    AuthSession?             @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces      AuthSession?             @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}
