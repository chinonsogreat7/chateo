NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://chateo:chateo@localhost:5432/chateo?schema=public

# Generate independent random values, for example: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-another-32-character-random-value

# Use console locally. Production must use twilio.
OTP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=

# Optional local test value. Leave blank to generate and log a random code in development.
AUTH_OTP_LENGTH=4
AUTH_FIXED_OTP=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=24
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_LOCK_SECONDS=900
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Keep enabled for classroom Swagger/OpenAPI access; set false to hide docs.
API_DOCS_ENABLED=true
REALTIME_MAX_CONNECTIONS_PER_USER=5
CORS_ORIGINS=
TRUST_PROXY=loopback

# Cloudinary-backed avatars, images, and optional audio/video/document uploads.
# Keep disabled until the credentials and a signed 5 MiB image upload preset are
# configured. The legacy image preset variable is shared by all three image purposes.
# The API secret belongs only on the server.
MEDIA_UPLOADS_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_AVATAR_UPLOAD_PRESET=
# Optional until chat audio is used. Configure a separate signed preset limited
# to aac,m4a,mp3,ogg,wav and 20 MiB before authorizing audio recordings.
CLOUDINARY_CHAT_AUDIO_UPLOAD_PRESET=
# Separate signed presets; leave unset to disable only that attachment kind.
# Video: mp4,mov,webm; max 50 MiB. Clients must prepare <=1920px and <=5min clips.
CLOUDINARY_CHAT_VIDEO_UPLOAD_PRESET=
# Raw documents: pdf,txt,docx,xlsx,pptx; max 25 MiB; no transformations.
CLOUDINARY_CHAT_DOCUMENT_UPLOAD_PRESET=
CLOUDINARY_UPLOAD_FOLDER=chateo
MEDIA_UPLOAD_TTL_SECONDS=600
MEDIA_MAX_PROFILE_AVATAR_BYTES=5242880
MEDIA_MAX_PROFILE_AVATAR_DIMENSION=2048
MEDIA_MAX_PROFILE_AVATAR_PIXELS=4194304
MEDIA_MAX_CHAT_AUDIO_BYTES=20971520
MEDIA_MAX_CHAT_AUDIO_DURATION_MS=900000
MEDIA_MAX_CHAT_VIDEO_BYTES=52428800
MEDIA_MAX_CHAT_VIDEO_DURATION_MS=300000
MEDIA_MAX_CHAT_DOCUMENT_BYTES=26214400

# Opt in only after deploying the unused-media migration. This permanently
# deletes unreferenced Cloudinary objects; current avatars/messages are protected.
MEDIA_UNUSED_CLEANUP_ENABLED=false
MEDIA_UNUSED_RETENTION_HOURS=24

# Expo push is opt-in. Configure EAS/APNs/FCM credentials on the Expo project,
# enable enhanced push security, then set this server-only Expo access token.
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_ACCESS_TOKEN=
PUSH_OFFLINE_DELAY_SECONDS=15

# Manual classroom seed guard. Never enable this as part of the normal start command.
ALLOW_DEMO_SEED=false
