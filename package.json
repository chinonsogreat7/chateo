{
  "name": "chateo",
  "version": "0.1.0",
  "private": true,
  "description": "ChatMe mobile chat application workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace @chateo/api",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start:api": "npm run start:prod --workspace @chateo/api",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @chateo/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    }
  }
}
